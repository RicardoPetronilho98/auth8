          "uuid": "88719f42-d5e5-4ae6-99b8-daacbad257be",
          "body": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <title>OAuth2 Authorization Success</title>\r\n  <style>\r\n    body {\r\n      font-family: Arial, sans-serif;\r\n      background: #f4f6f8;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      height: 100vh;\r\n      margin: 0;\r\n    }\r\n    .box {\r\n      background: white;\r\n      padding: 2rem 3rem;\r\n      border-radius: 12px;\r\n      box-shadow: 0 4px 20px rgba(0,0,0,0.1);\r\n      text-align: center;\r\n    }\r\n    .code {\r\n      margin-top: 1rem;\r\n      padding: 1rem;\r\n      background: #eef;\r\n      border-radius: 8px;\r\n      font-family: monospace;\r\n      font-size: 1.1rem;\r\n      word-break: break-word;\r\n    }\r\n    button {\r\n      margin-top: 1rem;\r\n      padding: 0.5rem 1rem;\r\n      font-size: 1rem;\r\n      border: none;\r\n      border-radius: 6px;\r\n      background-color: #007bff;\r\n      color: white;\r\n      cursor: pointer;\r\n    }\r\n    button:hover {\r\n      background-color: #0056b3;\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div class=\"box\">\r\n    <h2>✅ Authorization Code Flow Works!</h2>\r\n    <p>Here's the code:</p>\r\n    <div class=\"code\" id=\"code-box\">Loading...</div>\r\n    <button onclick=\"copyCode()\">Copy Code</button>\r\n  </div>\r\n\r\n  <script>\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    const code = urlParams.get(\"code\");\r\n    const codeBox = document.getElementById(\"code-box\");\r\n    codeBox.textContent = code || \"No code found.\";\r\n\r\n    function copyCode() {\r\n      navigator.clipboard.writeText(codeBox.textContent).catch(() => {});\r\n    }\r\n  </script>\r\n</body>\r\n</html>\r\n",
